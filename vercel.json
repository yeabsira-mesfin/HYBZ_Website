{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm ci --prefix dashboard && VITE_PUBLIC_DEMO=true npm run build --prefix dashboard",
  "outputDirectory": "dashboard/dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "excludeFiles": "{Assets/**,dashboard/node_modules/**,tests/**,docs/**,data/**}"
    }
  },
  "rewrites": [{"source": "/api/:path*", "destination": "/api/index"}]
}
